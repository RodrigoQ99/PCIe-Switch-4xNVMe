procedure( fp_all()
  fpLogPort = outfile("fp_gen.log" "w")
  unless(errset(fp_0() t) fpLog("  FALLO SKILL en fp_0"))
  unless(errset(fp_1() t) fpLog("  FALLO SKILL en fp_1"))
  unless(errset(fp_2() t) fpLog("  FALLO SKILL en fp_2"))
  unless(errset(fp_3() t) fpLog("  FALLO SKILL en fp_3"))
  unless(errset(fp_4() t) fpLog("  FALLO SKILL en fp_4"))
  unless(errset(fp_5() t) fpLog("  FALLO SKILL en fp_5"))
  fpLog("fin")
  close(fpLogPort) fpLogPort = nil
  axlOpenDesign(?design "fp_blank.dra" ?mode "wf"))
