;; borra TODAS las clines y vias de la placa (deshacer)
procedure( fo_clear()
  let((l)
    l = nil
    foreach(n axlDBGetDesign()->nets foreach(b n->branches foreach(o b->children
      when(member(o->objType list("via" "path")) l = cons(o l)))))
    printf("borrando %d\n" length(l))
    axlDeleteObject(l)))
