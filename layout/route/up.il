procedure( up_del()
  let((l)
    l = nil
    foreach(n axlDBGetDesign()->nets
      when(member(n->name list("CREFCLKN" "CREFCLKP" "PERN0_RECEPT" "PERN1_RECEPT" "PERN2_RECEPT" "PERN3_RECEPT" "PERP0_RECEPT" "PERP1_RECEPT" "PERP2_RECEPT" "PERP3_RECEPT" "PETN0_P0" "PETN0_RECEPT" "PETN1_P0" "PETN1_RECEPT" "PETN2_P0" "PETN2_RECEPT" "PETN3_P0" "PETN3_RECEPT" "PETP0_P0" "PETP0_RECEPT" "PETP1_P0" "PETP1_RECEPT" "PETP2_P0" "PETP2_RECEPT" "PETP3_P0" "PETP3_RECEPT"))
        foreach(b n->branches foreach(o b->children
          when(o->objType == "path" && (rexMatchp("^PER" n->name) || o->layer == "ETCH/BOTTOM") l = cons(o l))))))
    printf("borrando %d clines\n" length(l))
    axlDeleteObject(l)))

